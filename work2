from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC

def fetch_cva_assignments(username, password):
    """
    Automated scraper to pull pending assignments from Canyons Virtual Academy's Agilix Buzz portal.
    """
    options = webdriver.ChromeOptions()
    # options.add_argument('--headless') # Uncomment to run invisibly in the background
    driver = webdriver.Chrome(options=options)
    
    try:
        print("Initializing CVA payload...")
        driver.get("https://canyonsva.agilixbuzz.com/")
        
        # Locate login elements for Buzz LMS
        WebDriverWait(driver, 10).until(
            EC.presence_of_element_located((By.NAME, "Username"))
        ).send_keys(username)
        
        driver.find_element(By.NAME, "Password").send_keys(password)
        driver.find_element(By.XPATH, "//button[@type='submit']").click()
        
        print("Bypassing gateway, scanning for assignment modules...")
        
        # Wait for the Buzz To-Do/Activity list to populate
        WebDriverWait(driver, 15).until(
            EC.presence_of_element_located((By.CLASS_NAME, "activity-title"))
        )
        
        # Scrape all activity cards
        activities = driver.find_elements(By.CLASS_NAME, "activity-card")
        
        assignment_list = []
        for activity in activities:
            title = activity.find_element(By.CLASS_NAME, "activity-title").text
            try:
                due_date = activity.find_element(By.CLASS_NAME, "due-date").text
            except:
                due_date = "No Due Date / Self-Paced"
                
            assignment_list.append({"title": title, "due": due_date})
            
        print("\n=== PENDING CVA MODULES ===")
        for item in assignment_list:
            print(f"- {item['title']} (Due: {item['due']})")
            if "Proctored" in item['title']:
                print("  * ALARM: Proctored exam detected. Requires physical test center appointment.")
                
    except Exception as e:
        print(f"Extraction failed. DOM may have updated: {e}")
    finally:
        driver.quit()

if __name__ == "__main__":
    user_id = input("CSD/CVA Username: ")
    user_key = input("CSD/CVA Password: ")
    fetch_cva_assignments(user_id, user_key)
